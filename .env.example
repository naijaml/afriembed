# Copy to .env. google/embeddinggemma-2 is gated: accept the license on Hugging Face, then set a read token.
HF_TOKEN=hf_xxx
# Where downloaded audio/images/indices are cached (default: ./data_cache)
AFRIEMBED_CACHE=./data_cache
# Where mteb stores raw task results (default: ./mteb_cache)
MTEB_CACHE=./mteb_cache
